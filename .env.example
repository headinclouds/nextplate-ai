# Cloudinary Configuration (for production image storage)
# Sign up at: https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Node Environment
NODE_ENV=development
# For production: NODE_ENV=production

# Vercel Postgres connection string (required for writable Vercel production)
# This is automatically provided when you add Vercel Postgres integration
POSTGRES_URL=postgres://user:password@host:5432/database

# Optional local SQLite fallback path (used when POSTGRES_URL is not set)
SQLITE_PATH=meals.db

# Better Auth configuration
# Generate a value with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_random_32_byte_secret
# Local URL for development; replace with your production URL when deploying
BETTER_AUTH_URL=http://localhost:3000
